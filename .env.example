# Copy to .env and fill in values before running locally.

# --- Required in production (DEBUG=False) ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Environment ---
# Set to "false" for production. Defaults to "true" if neither DEBUG nor RENDER is set.
DEBUG=true

# --- Database ---
# Defaults to local PostgreSQL when unset.
DATABASE_URL=postgresql://localhost:5432/teachkadb

# --- Email (seznam.cz SMTP) ---
MAIL=your@email.cz
MAIL_PASSWORD=your-smtp-password

# --- Observability (optional) ---
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# --- Render.com (set automatically by Render, do not set manually) ---
# RENDER=true
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
