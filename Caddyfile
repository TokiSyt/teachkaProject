# Caddy auto-provisions Let's Encrypt TLS for these hostnames.
# Redirects www -> apex, reverse-proxies everything to the Django web container.
# WhiteNoise serves static; Cloudinary serves media — Caddy just proxies.

# Renew certs via Cloudflare DNS-01 challenge (token from env). This works even
# when Cloudflare's orange-cloud proxy is on, which blocks HTTP-01 on port 80.
{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

www.teachka.com {
	redir https://teachka.com{uri} permanent
}

teachka.com {
	encode gzip zstd

	reverse_proxy web:8000 {
		# Channels/WebSockets (live quiz) pass through automatically.
		# Caddy sets X-Forwarded-Proto=https, matching SECURE_PROXY_SSL_HEADER.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
